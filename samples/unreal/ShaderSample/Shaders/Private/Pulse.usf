#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"
#include "/ShaderSample/Private/Palette.ush"
#include "/Project/Private/Palette.ush"

#ifndef THREADGROUP_SIZE
#define THREADGROUP_SIZE 8
#endif

float Time;
float2 OutputSize;
RWTexture2D<float4> Output;

[numthreads(THREADGROUP_SIZE, THREADGROUP_SIZE, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	float2 UV = (float2(DispatchThreadId.xy) + 0.5) / OutputSize;
	float Distance = length(UV * 2.0 - 1.0);
	Output[DispatchThreadId.xy] = float4(PulsePalette(Distance + Time) * saturate(1.0 - Distance), 1.0);
}
